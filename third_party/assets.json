      "commit": null,
      "spdx": "CC0-1.0",
      "authors": "gfn1-rs contributors (independently generated numerical data)",
      "changes": "Original 23-point calculation; full-active-space two-electron CASCI, no frozen core, analytic gradients; numerical report generated by the native training CLI",
      "units": "hartree, angstrom, hartree/bohr",
      "elements": "H; neutral H2, 0.45..3.00 angstrom",
      "reason": "Independent finite-basis molecular learning reference and held-out evaluation",
      "adoption_status": "verified"
    },

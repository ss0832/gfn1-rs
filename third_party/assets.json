    "independent_water_reference": {
      "url": "scripts/generate_water_clusters.py; https://doi.org/10.1063/5.0006074; https://doi.org/10.1063/1.478522; https://doi.org/10.1039/B508541A",
      "version": "PySCF 2.14.0 PBE0/def2-SVP; grid level 3 with analytic grid response",
      "commit": null,
      "spdx": "CC0-1.0",
      "authors": "gfn1-rs contributors (original constructed geometries and numerical calculations)",
      "changes": "Original 28 neutral structures: fourteen training, eight validation, five extrapolation, one shared monomer anchor; all tetramers held out; analytic gradients and total dipoles; uncorrected finite-basis supermolecular interactions",
      "units": "hartree, angstrom, hartree/bohr, e*bohr",
      "elements": "H and O; isolated water monomers, dimers, cyclic trimers and tetramers",
      "reason": "Independent multivariate molecular training data and disaggregated held-out metrics; not a complete-basis binding benchmark",

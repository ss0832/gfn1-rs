      "commit": "0060d4652a5a262fbda2276801f1244060d67128",
      "spdx": "CC0-1.0 AND LicenseRef-COD-Public-Domain",
      "authors": "Original crystal authors and COD contributors, individually attributed in fixture metadata; independent prototypes by gfn1-rs contributors",
      "changes": "Seven ideal real-material prototypes at declared lattice parameters; three experimental COD geometries. Cell/site fields only, dummy centroids removed, symmetry expanded, primitive reduction without idealization, wrapped positions; no geometry relaxation or H completion; source hashes and temperatures retained",
      "units": "angstrom and amu; explicitly specified numerical-control cutoffs in bohr",
      "elements": "Ten declared materials: NaCl, MgO, diamond, Si, ZnS, SiC, SrTiO3, Na2MoO4, benzene I and a ferrocenyl(diphenyl)methanol/DMSO crystal",
      "reason": "Provenance-tracked unrelaxed inputs for real-material phonon/force-wave validation; no fitted force constants or blanket stability claim",
      "adoption_status": "verified"
    },

    "xtb_solv_v671": {
      "url": "https://github.com/grimme-lab/xtb",
      "version": "v6.7.1",
      "commit": "26b28010e805f7d1aeeef39813feb473e69cc4be",
      "spdx": "LGPL-3.0-or-later",
      "authors": "Sebastian Ehlert (2019-2020); Stefan Grimme (2017-2020); Lebedev-Laikov grid attribution retained in lebedev.f90",
      "changes": "Original source/include files exported verbatim by git archive. Rust adaptation in solvation.rs uses first-order forward AD, immutable geometry caches and explicit CM5 mapping; no parameter refitting. The supplied prototype archive uses LF for 49 source/include files whose inherited ledger recorded CRLF. Reintroducing CRLF exactly reproduces every previous hash; the supplied LF bytes were preserved.",
      "units": "Parameter keyword units per model.f90; D3/CM5 radii in angstrom; internal bohr/hartree; normalized Lebedev weights",
      "elements": "GFN1 Z=1..86; only explicit GFN1 blocks are selected; GFN2-only GBSA DMF/hexane are rejected",
      "reason": "GFN1 ALPB/P16, GBSA/Still, CM5, radii, surface quadrature and state definitions",
      "adoption_status": "verified"
    },
    "independent_ml": {
      "url": "src/bin/gfn1_rs_train.rs (demo-h2)",
      "version": "radial-hamiltonian-v1",
      "commit": null,
      "spdx": "GPL-3.0-or-later",
      "authors": "gfn1-rs contributors",
      "changes": "Independently trained from seven synthetic GFN1 H2 Hamiltonian energies generated by the bundled training recipe; zero pretrained third-party weights",
      "units": "hartree and bohr",
      "elements": "H only; neutral H2 training domain, 0.60..1.40 angstrom",
      "reason": "Small reproducible training/inference/force demonstration; not a chemical-accuracy or MACE model",
      "adoption_status": "verified"
    },
    "independent_h2_reference": {

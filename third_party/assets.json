      "spdx": "GPL-3.0-or-later",
      "authors": "gfn1-rs contributors",
      "changes": "Independent zero-initialized native radial heads fitted to ten FCI/cc-pVTZ H2 energies using AdamW; no third-party pretrained weights",
      "units": "hartree, bohr",
      "elements": "H; neutral molecular H2 training domain 0.50..1.90 angstrom",
